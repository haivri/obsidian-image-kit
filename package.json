{
  "name": "image-kit",
  "version": "0.1.5",
  "description": "Size, align, caption, and view images in Obsidian notes. Layout is saved in the link itself.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit -p tsconfig.json && node esbuild.config.mjs production",
    "publish:vault": "npm run build && node publish-vault.mjs",
    "ship": "npm run publish:vault && git push origin",
    "lint": "eslint src/**/*.ts",
    "test": "node --test tests/*.test.mjs",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "image",
    "resize",
    "align",
    "caption",
    "fullscreen",
    "lightbox"
  ],
  "author": "Robert Fleming",
  "license": "MIT",
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.4.0",
    "globals": "^17.6.0",
    "jsdom": "^30.0.1",
    "obsidian": "1.13.1",
    "typescript": "^5.5.0"
  }
}
